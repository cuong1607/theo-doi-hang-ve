# ============================================================
# Zalo Personal worker — copy to .env (git-ignored) and edit.
# This file must never contain real values.
# ============================================================

# Master switch. Nothing connects to Zalo unless this is true.
ZP_ENABLED=false

# Logical name of this connection (a-z, 0-9, _ and -). One worker per connection.
ZP_CONNECTION_ID=primary

# Where the protected session, health file, metadata logs and QR live.
# Default (leave empty): %LOCALAPPDATA%\CongTrangBedding\zalo-personal on Windows,
# ~/.local/state/congtrangbedding/zalo-personal on Linux. Must be OUTSIDE the repo
# (the only allowed in-repo location is services/zalo-personal-worker/.data, git-ignored).
ZP_DATA_DIR=

# Session encryption: "dpapi" (Windows, default) or "aes-key" (Linux VPS).
ZP_SESSION_PROTECTION=
# Only for aes-key: 32 random bytes, base64 (openssl rand -base64 32).
# On a VPS inject it from the service's secret store, not from this file.
ZP_SESSION_KEY=

# Approved groups (comma-separated numeric ids). Empty = no group is monitored.
ZP_ALLOWED_GROUP_IDS=

# Group id discovery: send EXACTLY this text from YOUR OWN account in a group to
# print that group's id. 12-64 chars, no spaces, hard to guess. Empty = discovery off.
ZP_DISCOVERY_TOKEN=

# Direct (1-1) messages: "metadata" (default: no text leaves the worker), "content" (text is sent;
# the server keeps it only if its direct_message_mode is content) or "off".
ZP_DIRECT_MESSAGES=metadata

# debug | info | warn | error
ZP_LOG_LEVEL=info

# QR login: max QR codes per login (1-5) and whether to open the image automatically (Windows).
ZP_QR_MAX_ATTEMPTS=3
ZP_QR_AUTO_OPEN=true

# Reconnect backoff (bounded). After ZP_RECONNECT_MAX_ATTEMPTS consecutive failures the worker stops.
ZP_RECONNECT_BASE_MS=2000
ZP_RECONNECT_MAX_MS=120000
ZP_RECONNECT_MAX_ATTEMPTS=6
ZP_CONNECT_TIMEOUT_MS=45000

# Housekeeping
ZP_HEALTH_INTERVAL_MS=15000
ZP_STOP_POLL_MS=2000
ZP_METADATA_RETENTION_DAYS=7

# --- Phase 02: delivery to the backend (docs/zalo-ai/phase-02-integration.md) ---
# Off by default. When on, allowed events go to an encrypted local outbox and are
# delivered over HTTPS with an HMAC signature. ZP_CONNECTION_ID above must equal the
# connection_key created on the server. The worker never holds a Supabase key.
ZP_INGEST_ENABLED=false
# Backend base URL: https only (http allowed for localhost during local tests).
ZP_INGEST_URL=
# Worker identity issued by the administrator (zalo-personal:admin worker:create).
ZP_WORKER_KEY=
# The HMAC secret is NOT put here on Windows: run "npm run ingest:set-secret" (stored with DPAPI).
# On a VPS it may be injected by the service manager instead:
# ZP_INGEST_SECRET=
# Optional tuning (defaults shown)
# ZP_INGEST_BATCH_SIZE=25
# ZP_INGEST_MAX_ATTEMPTS=12
# ZP_INGEST_TIMEOUT_MS=15000
# ZP_INGEST_BACKOFF_BASE_MS=2000
# ZP_INGEST_BACKOFF_MAX_MS=900000
# ZP_HEARTBEAT_INTERVAL_MS=60000
# ZP_OUTBOX_MAX_EVENTS=5000
# ZP_OUTBOX_MAX_BYTES=20971520

# ------------------------------------------------------------------ Phase 04.5 — send APPROVED replies (default OFF)
# Needs ZP_INGEST_ENABLED=true (same signed client). The backend still decides (PERSONAL_SEND_ENABLED,
# emergency stop, per-connection pause, group mode, identity, rate limits). `npm run stop` stops everything.
# To answer 1-1 chats the worker must also send text: ZP_DIRECT_MESSAGES=content (and the connection in content mode).
ZP_SEND_ENABLED=false
ZP_SEND_POLL_MS=15000
# a send without an answer within this window is "delivery unknown" (never retried automatically)
ZP_SEND_TIMEOUT_MS=20000
# local brake between two sends from this account
ZP_SEND_MIN_INTERVAL_MS=5000
