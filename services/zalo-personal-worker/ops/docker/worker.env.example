# PHASE 07 — environment of the Linux container (copy to worker.env, chmod 600, NEVER commit it).
# Every value below is an example / placeholder.
ZP_ENABLED=true
ZP_CONNECTION_ID=zalo-ban-hang-xxxx
# Linux has no DPAPI: the session file is AES-256-GCM encrypted with this key.
# 32 random bytes, base64:  openssl rand -base64 32   (store it in your secret manager too)
ZP_SESSION_PROTECTION=aes-key
ZP_SESSION_KEY=
ZP_DIRECT_MESSAGES=content
ZP_ALLOWED_GROUP_IDS=
ZP_DISCOVERY_TOKEN=
ZP_LOG_LEVEL=info
ZP_QR_AUTO_OPEN=false
# backend (HTTPS + HMAC): issued by an admin on the dashboard (Kết nối → worker)
ZP_INGEST_ENABLED=true
ZP_INGEST_URL=https://your-app.example.com
ZP_WORKER_KEY=
# on Windows this secret is stored with DPAPI (npm run ingest:set-secret); in a container: env
ZP_INGEST_SECRET=
# sending stays OFF until the owner decides (the server flags and the per-connection switch apply too)
ZP_SEND_ENABLED=false
