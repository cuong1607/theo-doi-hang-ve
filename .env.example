# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://qjaopxeuftpsrcvrevyo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cAVzF2b7b7_XhiWsVvsuXQ_GPEAmLFC

# Server-only, bypasses RLS. Never expose to the browser. Temporary until
# Phase 5 (Authentication) lands a per-user server client.
SUPABASE_SERVICE_ROLE_KEY=

# Roles now come from Supabase Auth + public.profiles (see
# docs/authentication-authorization.md). NEXT_PUBLIC_MOCK_ROLE is no longer
# read — remove it from .env.local / Vercel. Only the URL + anon key above
# may be NEXT_PUBLIC_*; SUPABASE_SERVICE_ROLE_KEY stays server-only.

# Zalo Official Account (Phase ZL1) — all server-only, never NEXT_PUBLIC_*.
# See docs/zalo-integration.md for the full setup guide.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=

# Symmetric key used to encrypt access/refresh tokens before storing them in
# zalo_connections (AES-256-GCM, see src/lib/zalo/crypto.ts). Any non-empty
# random string works — e.g. `openssl rand -base64 32`.
ZALO_TOKEN_ENCRYPTION_KEY=

# Manual token bootstrap for testing sendZaloTextMessage before OAuth has
# ever been completed. Optional — leave blank once OAuth is connected.
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# UID of the Zalo account that should receive the test message (see
# docs/zalo-integration.md "Cách lấy recipient UID" — never guess this).
ZALO_TEST_RECIPIENT_ID=

# Public app URL, used to build the OAuth redirect_uri
# (${APP_URL}/api/zalo/oauth/callback). Must match the callback URL
# configured on the Zalo OA exactly.
APP_URL=https://theo-doi-hang-ve.vercel.app

# Shopee Open Platform (Phase SHOPEE-1) — all server-only, never NEXT_PUBLIC_*.
# See docs/shopee-auth-runbook.md. Values come from the Shopee Open Platform
# console (App → partner id / partner key). Live and test (sandbox) apps
# have DIFFERENT partner id/key AND host — never mix them.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Optional. Default = production https://partner.shopeemobile.com.
# Sandbox: https://partner.test-stable.shopeemobile.com
SHOPEE_API_BASE_URL=
# Optional. Default = ${APP_URL}/api/shopee/auth/callback. Its domain must
# match the redirect domain registered for the app on Shopee.
SHOPEE_REDIRECT_URL=

# Phase SHOPEE-2 — product data source: live | fixture.
# Default: production → live, otherwise → fixture. Fixture mode is refused in
# production unless ENABLE_SHOPEE_FIXTURE_MODE=true. Never silently falls back.
SHOPEE_PROVIDER_MODE=
ENABLE_SHOPEE_FIXTURE_MODE=

# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts provider
# tokens at rest (shop_connections). Changing it makes stored tokens
# undecryptable → every shop must be reconnected.
APP_ENCRYPTION_KEY=

# Phase ZL6 — authorizes Vercel Cron requests to /api/cron/*. Server-only,
# never NEXT_PUBLIC_*. Set the SAME value in the Vercel project's env vars;
# Vercel then sends it back as `Authorization: Bearer $CRON_SECRET` on every
# scheduled invocation (see docs/zalo-integration.md "Cron scheduling").
# Any long random string works — e.g. `openssl rand -base64 32`.
CRON_SECRET=

# Phase SHOPEE-PERF-1 - background Shopee sync (docs/shopee-sync-operations.md).
# Server-only. Authorizes /api/internal/shopee/sync-worker and
# /api/internal/shopee/sync-scheduler (Supabase pg_cron / external cron /
# the worker's own chaining). CRON_SECRET is accepted too (Vercel Cron).
# Any long random string, e.g. `openssl rand -base64 32`.
# SHOPEE-PERF-2: SHOPEE_SYNC_INTERNAL_SECRET is the preferred name - pg_cron sends
# it (the same value is stored in Supabase Vault as shopee_sync_internal_secret).
# SYNC_WORKER_SECRET is still accepted. Never NEXT_PUBLIC, never committed.
SHOPEE_SYNC_INTERNAL_SECRET=
SYNC_WORKER_SECRET=
# Optional tuning - conservative defaults apply when unset (see the doc).
# SHOPEE_SYNC_GLOBAL_WORKERS=1
# SHOPEE_SYNC_SCHEDULER_WORKER_TRIGGERS=1
# SHOPEE_SYNC_ORDER_CONCURRENCY=3
# SHOPEE_SYNC_PRODUCT_CONCURRENCY=3
# SHOPEE_SYNC_ESCROW_CONCURRENCY=2
# SHOPEE_SYNC_ORDER_OVERLAP_MINUTES=10
# SHOPEE_SYNC_ACTIVE_ORDER_TTL_MINUTES=30
# SHOPEE_SYNC_MAX_BATCH_API_CALLS=30
# SHOPEE_SYNC_WORKER_BUDGET_MS=45000
# SHOPEE_SYNC_ORDER_INTERVAL_MINUTES=5
# SHOPEE_SYNC_PRODUCT_INTERVAL_MINUTES=60
# SHOPEE_SYNC_SCHEDULER_WARN_AFTER_MINUTES=5
# SHOPEE_SYNC_JOB_RETENTION_DAYS=30
# SHOPEE_SYNC_MAX_CHAIN_HOPS=0
# Phase SHOPEE-5 escrow (order financials) job - docs/shopee-financial-validation.md
# SHOPEE_SYNC_ESCROW_BATCH_SIZE=20
# SHOPEE_SYNC_ESCROW_INTERVAL_MINUTES=15
# SHOPEE_SYNC_ESCROW_REFRESH_WINDOW_DAYS=14
# SHOPEE_SYNC_ESCROW_REFRESH_INTERVAL_HOURS=24
# SHOPEE_SYNC_ESCROW_ERROR_BACKOFF_HOURS=6
# Staged rollout: only these shop ids (comma-separated); empty = every active shop.
# SHOPEE_SYNC_SHOP_IDS=
