# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://qjaopxeuftpsrcvrevyo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cAVzF2b7b7_XhiWsVvsuXQ_GPEAmLFC

# Server-only, bypasses RLS. Never expose to the browser. Temporary until
# Phase 5 (Authentication) lands a per-user server client.
SUPABASE_SERVICE_ROLE_KEY=

# Roles now come from Supabase Auth + public.profiles (see
# docs/authentication-authorization.md). NEXT_PUBLIC_MOCK_ROLE is no longer
# read — remove it from .env.local / Vercel. Only the URL + anon key above
# may be NEXT_PUBLIC_*; SUPABASE_SERVICE_ROLE_KEY stays server-only.

# Zalo Official Account (Phase ZL1) — all server-only, never NEXT_PUBLIC_*.
# See docs/zalo-integration.md for the full setup guide.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=

# Symmetric key used to encrypt access/refresh tokens before storing them in
# zalo_connections (AES-256-GCM, see src/lib/zalo/crypto.ts). Any non-empty
# random string works — e.g. `openssl rand -base64 32`.
ZALO_TOKEN_ENCRYPTION_KEY=

# Manual token bootstrap for testing sendZaloTextMessage before OAuth has
# ever been completed. Optional — leave blank once OAuth is connected.
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# UID of the Zalo account that should receive the test message (see
# docs/zalo-integration.md "Cách lấy recipient UID" — never guess this).
ZALO_TEST_RECIPIENT_ID=

# Zalo OA conversation webhook (docs/zalo-ai-agent-architecture.md).
# Off by default. OA Secret Key = Zalo OA webhook settings ("OA Secret Key"),
# used to verify X-ZEvent-Signature — the webhook fails closed without it.
ZALO_CONVERSATION_ENABLED=false
ZALO_OA_SECRET_KEY=

# Future Claude Product Analyst (NOT implemented in this phase: even "true"
# only yields the placeholder reply). Model is configuration, never hardcoded.
AI_PRODUCT_ANALYST_ENABLED=false
AI_PRODUCT_ANALYST_PROVIDER=anthropic
AI_PRODUCT_ANALYST_MODEL=

# Public app URL, used to build the OAuth redirect_uri
# (${APP_URL}/api/zalo/oauth/callback). Must match the callback URL
# configured on the Zalo OA exactly.
APP_URL=https://theo-doi-hang-ve.vercel.app

# Shopee Open Platform (Phase SHOPEE-1) — all server-only, never NEXT_PUBLIC_*.
# See docs/shopee-auth-runbook.md. Values come from the Shopee Open Platform
# console (App → partner id / partner key). Live and test (sandbox) apps
# have DIFFERENT partner id/key AND host — never mix them.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Optional. Default = production https://partner.shopeemobile.com.
# Sandbox: https://partner.test-stable.shopeemobile.com
SHOPEE_API_BASE_URL=
# Optional. Default = ${APP_URL}/api/shopee/auth/callback. Its domain must
# match the redirect domain registered for the app on Shopee.
SHOPEE_REDIRECT_URL=

# Phase SHOPEE-2 — product data source: live | fixture.
# Default: production → live, otherwise → fixture. Fixture mode is refused in
# production unless ENABLE_SHOPEE_FIXTURE_MODE=true. Never silently falls back.
SHOPEE_PROVIDER_MODE=
ENABLE_SHOPEE_FIXTURE_MODE=

# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts provider
# tokens at rest (shop_connections). Changing it makes stored tokens
# undecryptable → every shop must be reconnected.
APP_ENCRYPTION_KEY=

# Phase ZL6 — authorizes Vercel Cron requests to /api/cron/*. Server-only,
# never NEXT_PUBLIC_*. Set the SAME value in the Vercel project's env vars;
# Vercel then sends it back as `Authorization: Bearer $CRON_SECRET` on every
# scheduled invocation (see docs/zalo-integration.md "Cron scheduling").
# Any long random string works — e.g. `openssl rand -base64 32`.
CRON_SECRET=

# Phase SHOPEE-PERF-1 - background Shopee sync (docs/shopee-sync-operations.md).
# Server-only. Authorizes /api/internal/shopee/sync-worker and
# /api/internal/shopee/sync-scheduler (Supabase pg_cron / external cron /
# the worker's own chaining). CRON_SECRET is accepted too (Vercel Cron).
# Any long random string, e.g. `openssl rand -base64 32`.
# SHOPEE-PERF-2: SHOPEE_SYNC_INTERNAL_SECRET is the preferred name - pg_cron sends
# it (the same value is stored in Supabase Vault as shopee_sync_internal_secret).
# SYNC_WORKER_SECRET is still accepted. Never NEXT_PUBLIC, never committed.
SHOPEE_SYNC_INTERNAL_SECRET=
SYNC_WORKER_SECRET=
# Optional tuning - conservative defaults apply when unset (see the doc).
# SHOPEE_SYNC_GLOBAL_WORKERS=1
# SHOPEE_SYNC_SCHEDULER_WORKER_TRIGGERS=1
# SHOPEE_SYNC_ORDER_CONCURRENCY=3
# SHOPEE_SYNC_PRODUCT_CONCURRENCY=3
# SHOPEE_SYNC_ESCROW_CONCURRENCY=2
# SHOPEE_SYNC_ORDER_OVERLAP_MINUTES=10
# SHOPEE_SYNC_ACTIVE_ORDER_TTL_MINUTES=30
# SHOPEE_SYNC_MAX_BATCH_API_CALLS=30
# SHOPEE_SYNC_WORKER_BUDGET_MS=45000
# SHOPEE_SYNC_ORDER_INTERVAL_MINUTES=5
# SHOPEE_SYNC_PRODUCT_INTERVAL_MINUTES=60
# SHOPEE_SYNC_SCHEDULER_WARN_AFTER_MINUTES=5
# SHOPEE_SYNC_JOB_RETENTION_DAYS=30
# SHOPEE_SYNC_MAX_CHAIN_HOPS=0
# Phase SHOPEE-5 escrow (order financials) job - docs/shopee-financial-validation.md
# SHOPEE_SYNC_ESCROW_BATCH_SIZE=20
# SHOPEE_SYNC_ESCROW_INTERVAL_MINUTES=15
# SHOPEE_SYNC_ESCROW_REFRESH_WINDOW_DAYS=14
# SHOPEE_SYNC_ESCROW_REFRESH_INTERVAL_HOURS=24
# SHOPEE_SYNC_ESCROW_ERROR_BACKOFF_HOURS=6
# Staged rollout: only these shop ids (comma-separated); empty = every active shop.
# SHOPEE_SYNC_SHOP_IDS=

# --- SHOPEE-ADS-0: Shopee domain flags (src/lib/feature-flags.ts) ---
# Legacy Shopee modules (orders / products / returns / payouts / analytics / sync pages,
# their APIs, scheduler jobs and return notifications). Default false = retired.
SHOPEE_LEGACY_MODULES_ENABLED=false
# Shopee Ads module (route + future sync). Default true.
SHOPEE_ADS_ENABLED=true
# Idle connected shops get their token refreshed at most once per this many hours (default 24).
# SHOPEE_TOKEN_KEEPALIVE_HOURS=24

# --- ZALO PERSONAL Phase 02: ingestion API for the zca-js worker (docs/zalo-ai/phase-02-integration.md) ---
# Server-only. Off by default: the endpoints answer 503 and touch nothing.
ZALO_PERSONAL_INGEST_ENABLED=false
# Optional tuning (defaults shown). Worker HMAC secrets are NOT env vars: they live
# encrypted in zalo_personal_workers (APP_ENCRYPTION_KEY above) and are issued by
# `npm run zalo-personal:admin -- worker:create …`.
# ZALO_PERSONAL_MAX_SKEW_SECONDS=300
# ZALO_PERSONAL_RATE_LIMIT_PER_MINUTE=120
# ZALO_PERSONAL_MAX_BODY_BYTES=524288

# --- ZALO PERSONAL Phase 03: dashboard "Trợ lý Zalo AI → Zalo cá nhân" (docs/zalo-ai/phase-03-dashboard.md) ---
# Server-only. Off by default: the app is hidden, its pages answer 404, its API answers
# 404 not_enabled and no zalo_personal table is queried. Turn on only after migrations
# 00073 + 00074 are applied.
ZALO_PERSONAL_DASHBOARD_ENABLED=false

# --- ZALO PERSONAL Phase 04: Ask AI + summaries + memory (docs/zalo-ai/phase-04-ai-memory.md) ---
# Server-only. Independent from AI_PRODUCT_ANALYST_* (Web / OA assistant, unchanged).
# Engine kill switch + feature switch (both default false). Off: Ask AI still searches and
# shows the related messages, but nothing is sent to any provider.
AI_ENABLED=false
ZALO_PERSONAL_AI_ENABLED=false
# gemini (default) | fake (deterministic demo / tests; refused when NODE_ENV=production)
AI_PROVIDER=gemini
# Never NEXT_PUBLIC_*, never logged. No default model on purpose: models and quotas change.
GEMINI_API_KEY=
GEMINI_MODEL=
# free (default) | paid — what the owner declares about the Google AI Studio project.
GEMINI_TIER=free
# none (default: no real conversation leaves the server) | redacted | full
AI_DATA_SHARING_POLICY=none
# On the free tier Google may use inputs to improve its products: real chats are sent only
# when the owner approves it explicitly here (in addition to the policy above).
AI_FREE_TIER_DATA_APPROVED=false
# Budget (defaults shown; set them to your plan — limits are never hard-coded in code paths)
# AI_MAX_REQUESTS_PER_DAY=50
# AI_MAX_REQUESTS_PER_USER_PER_DAY=20
# AI_MAX_REQUESTS_PER_MINUTE=5
# AI_MAX_INPUT_TOKENS=12000
# AI_MAX_OUTPUT_TOKENS=1500
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_API_CALLS_PER_USER_PER_MINUTE=6
# AI_QUOTA_COOLDOWN_MINUTES=30
# AI_MAX_RETRIES=1
# AI_SESSION_RETENTION_DAYS=30

# --- Phase 05: Central AI System Assistant (docs/zalo-ai/phase-05-system-assistant.md) ---
# Read-only questions about business data. Uses the SAME Gemini provider, key, data policy
# and budget as above (AI_DATA_SHARING_POLICY=none → answers are shown without AI wording).
# Needs migration 00077. All OFF by default.
AI_SYSTEM_ASSISTANT_ENABLED=false
# Zalo OA adapter (not wired into the OA webhook in Phase 05) / Zalo Personal reply DRAFTS (never sent)
AI_SYSTEM_OA_ENABLED=false
AI_SYSTEM_PERSONAL_DRAFTS_ENABLED=false
# Limits (defaults shown)
# AI_SYSTEM_MAX_TOOL_CALLS=3
# AI_SYSTEM_TOOL_TIMEOUT_MS=8000
# AI_SYSTEM_MAX_ROWS=20
# AI_SYSTEM_REQUESTS_PER_MINUTE=6

# --- Phase 06: AI Task Detection & Smart Reminders (docs/zalo-ai/phase-06-task-reminders.md) ---
# Needs migration 00078 and ZALO_PERSONAL_DASHBOARD_ENABLED. All OFF by default.
# The engine runs from Supabase pg_cron every minute once the Vault secret 'ai_tasks_tick_url'
# (https://<domain>/api/internal/ai-tasks/tick) exists; it authenticates with the existing
# internal secret (SHOPEE_SYNC_INTERNAL_SECRET / CRON_SECRET). No Windows machine needed.
AI_TASKS_ENABLED=false
# Send task candidates to Gemini (also needs AI_ENABLED + the data policy above). Off → rules only.
AI_TASKS_AI_EXTRACTION_ENABLED=false
# AI_TASKS_RULES_FALLBACK=true
# AI_TASKS_MAX_CANDIDATES_PER_DAY=200
# AI_TASKS_MAX_EXTRACTIONS_PER_DAY=30
# AI_TASKS_BACKFILL_MINUTES=0
# AI_TASKS_TICK_BUDGET_MS=45000
# Reminder windows (defaults shown)
# AI_REMINDER_DAY_LEAD_HOURS=24
# AI_REMINDER_HOUR_LEAD_MINUTES=60
# AI_REMINDER_OVERDUE_DELAY_MINUTES=5
# AI_REMINDER_MORNING_HOUR=8
# AI_REMINDER_MORNING_CUTOFF_HOUR=10
# AI_REMINDER_DAY_GRACE_MINUTES=60
# AI_REMINDER_HOUR_GRACE_MINUTES=15
# AI_REMINDER_OVERDUE_ON_TIME_MINUTES=60
# AI_REMINDER_MAX_ATTEMPTS=5
# AI_REMINDER_BACKOFF_BASE_SECONDS=60
# Zalo notification adapter: NO real sender exists yet (Phase 04.5 not built). Kill switch ON by default.
ZALO_NOTIFY_KILL_SWITCH=true
ZALO_NOTIFY_PERSONAL_ENABLED=false
ZALO_NOTIFY_OA_ENABLED=false
# ZALO_NOTIFY_MAX_PER_USER_PER_HOUR=6